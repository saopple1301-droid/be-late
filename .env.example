# LINE Messaging API (LINE Developers console)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Stripe (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Public base URL of this service (used to build Checkout success/cancel URLs)
PUBLIC_BASE_URL=https://example.ngrok.app

# Database
DATABASE_URL=sqlite:///./be_late.db

# Currency for all amounts (ISO 4217, lowercase). Amounts in this app are
# treated as whole units of this currency (e.g. yen, no decimal subunits).
CURRENCY=jpy

# Minutes before the meetup time that the "doubt" prediction phase opens.
DOUBT_PHASE_MINUTES_BEFORE=120

# LINE Login channel ID backing the webapp/ LIFF app - used to verify the
# LIFF ID token the companion app sends on every /api/* request.
LIFF_CHANNEL_ID=

# Comma-separated origins allowed to call /api/* (the webapp's deployed
# URL), or "*" for any origin (fine for local development only).
CORS_ALLOW_ORIGINS=*
