# LINE Messaging API (LINE Developers console)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Database
DATABASE_URL=sqlite:///./be_late.db

# Minutes before the meetup time that the "doubt" prediction phase opens.
DOUBT_PHASE_MINUTES_BEFORE=120

# LINE Login channel ID backing the webapp/ LIFF app - used to verify the
# LIFF ID token the companion app sends on every /api/* request.
LIFF_CHANNEL_ID=

# Comma-separated origins allowed to call /api/* (the webapp's deployed
# URL), or "*" for any origin (fine for local development only).
CORS_ALLOW_ORIGINS=*

# NOTE: this is a hackathon demo build. There is no payment processor wired
# in - app/payments.py simulates every deposit hold/capture/release and
# penalty charge as an instant no-op, so no Stripe (or similar) keys are
# needed here.
